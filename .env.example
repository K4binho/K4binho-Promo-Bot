# Telegram
TELEGRAM_BOT_TOKEN=coloque_o_token_do_BotFather
TELEGRAM_CHANNEL_ID=@seu_canal_ou_-100xxxxxxxxxx
# Thread geral (fallback quando um tópico está desativado com 0). Vazio = raiz do canal.
TELEGRAM_THREAD_ID=
TELEGRAM_ADMIN_CHAT_ID=

# Tópicos do fórum (IDs do grupo). Sobrescreva se recriar os tópicos; 0 desativa.
TELEGRAM_TOPIC_MELHORES_DO_DIA=2194
TELEGRAM_TOPIC_JOGOS=2195
TELEGRAM_TOPIC_TECNOLOGIA=2197
TELEGRAM_TOPIC_CASA_COZINHA=2198
TELEGRAM_TOPIC_MODA_BELEZA=2201
TELEGRAM_TOPIC_FERRAMENTAS_AUTO=2202
TELEGRAM_TOPIC_ACHADINHOS=2205

# Vitrine "Melhores do Dia" (sem coleta própria; copia as melhores publicações)
MELHORES_DO_DIA_ENABLED=true
MELHORES_DO_DIA_MAX_PER_CYCLE=2
MELHORES_DO_DIA_MAX_PER_DAY=8
MELHORES_DO_DIA_MIN_DISCOUNT=40
MELHORES_DO_DIA_MIN_GAME_DISCOUNT=70

# Mercado Livre - OAuth + afiliado
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_AFFILIATE_TAG=
ML_SITE=MLB
ML_HIGHLIGHT_CATEGORY_IDS=MLB1055,MLB1000,MLB1648,MLB1574,MLB1246

# Curadoria comercial ML
SCORE_MIN=70
LAUNCH_SCORE=95
PRICE_MIN=30
MIN_HISTORY_OBS=4
PRICE_HISTORY_DAYS=30
POLL_INTERVAL_SECONDS=900
MAX_POSTS_PER_CYCLE=5

# Promotion Engine V1
# Copie promotions.example.json para promotions.json e ative apenas cupons/campanhas confirmados.
PROMOTIONS_FILE=promotions.json
# ML: abre uma amostra de anúncios no Chrome logado para detectar cupons visíveis.
ML_COUPON_DISCOVERY_ENABLED=true
ML_COUPON_SCAN_ITEMS=16
ML_COUPON_CACHE_HOURS=6
ML_COUPON_POSITIVE_CACHE_HOURS=2
ML_PROMO_REVIVAL_COOLDOWN_HOURS=6
ML_PROMO_REVIVAL_MIN_DROP_PERCENT=5
ML_PROMO_REVIVAL_MIN_DROP_AMOUNT=20
# Avisos únicos de campanhas futuras descritas em promotions.json.
PROMOTION_CAMPAIGN_NOTICES_ENABLED=true

# Steam / ITAD (editorial, tópico Jogos)
ITAD_API_KEY=
STEAM_MIN_DISCOUNT_PERCENT=40
STEAM_MAX_POSTS_PER_CYCLE=5
STEAM_BUNDLE_SCAN_APPS=24
STEAM_MIN_REVIEW_SCORE=80
STEAM_MIN_REVIEW_COUNT=500
STEAM_MIN_WAITLISTED=1000
PLUS_EDITORIAL_MIN_SCORE=25
PLUS_EDITORIAL_HOURS_WITHOUT=24

# AliExpress - Open Platform / Portals
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=default
# Formato: palavra:category_id,palavra:category_id. Categoria pode ficar vazia.
# Cubra também Casa, Moda e Ferramentas para alimentar todos os tópicos.
ALIEXPRESS_SEARCHES=SSD:7,teclado:7,mouse:7,fone bluetooth:44,furadeira:1420,alicate:1420,air fryer:,organizador cozinha:,relogio masculino:36,vestido:,tenis:
ALIEXPRESS_MIN_DISCOUNT_PERCENT=30
ALIEXPRESS_MAX_POSTS_PER_CYCLE=3

# Shopee Afiliados (Open API GraphQL). Nunca commitar SHOPEE_APP_SECRET.
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_SEARCHES=air fryer,panela,organizador,vestido,tenis,perfume,maquiagem,fone bluetooth,carregador,brinquedo,pet
SHOPEE_MIN_DISCOUNT_PERCENT=30
SHOPEE_MIN_SALES=20
SHOPEE_MAX_POSTS_PER_CYCLE=3

# KaBuM! via Awin (link builder). Nunca commitar KABUM_AWIN_TOKEN.
KABUM_AWIN_TOKEN=
KABUM_PUBLISHER_ID=
KABUM_MIN_DISCOUNT_PERCENT=20
KABUM_MAX_POSTS_PER_CYCLE=3

# Green Man Gaming via impact.com (NÃO é CJ Affiliate).
# CJ_ACCOUNT_SID / CJ_AUTH_TOKEN continuam aceitos apenas como aliases legados.
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
GMG_PROGRAM_ID=
GMG_CATALOG_ID=
GMG_CATALOG_CURRENCY=BRL
GMG_CATALOG_PAGE_SIZE=1000
GMG_CATALOG_MAX_PAGES=10
GMG_MIN_DISCOUNT_PERCENT=30
GMG_MAX_POSTS_PER_CYCLE=3

# Nuuvem - via ITAD (editorial, tópico Jogos)
NUUVEM_MIN_DISCOUNT_PERCENT=20
NUUVEM_MAX_POSTS_PER_CYCLE=3

# Digest (vai para Melhores do Dia)
DIGEST_ENABLED=true
DIGEST_HOUR=21
DIGEST_MAX_ITEMS=5

# Click Tracking
CLICK_TRACKING_ENABLED=false
CLICK_SERVER_PORT=8321
CLICK_BASE_URL=http://localhost:8321
