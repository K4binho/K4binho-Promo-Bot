# Telegram
TELEGRAM_BOT_TOKEN=coloque_o_token_do_BotFather
TELEGRAM_CHANNEL_ID=@seu_canal_ou_-100xxxxxxxxxx
TELEGRAM_THREAD_ID=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_STEAM_THREAD_ID=
TELEGRAM_ALIEXPRESS_THREAD_ID=
TELEGRAM_NUUVEM_THREAD_ID=
TELEGRAM_GMG_THREAD_ID=

# Mercado Livre - OAuth + afiliado
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_AFFILIATE_TAG=
ML_SITE=MLB
ML_HIGHLIGHT_CATEGORY_IDS=MLB1055,MLB1000,MLB1648,MLB1574,MLB1246

# Curadoria comercial ML
SCORE_MIN=70
LAUNCH_SCORE=95
PRICE_MIN=30
MIN_HISTORY_OBS=4
PRICE_HISTORY_DAYS=30
POLL_INTERVAL_SECONDS=900
MAX_POSTS_PER_CYCLE=5
# Fontes bloqueantes rodam em threads, limitadas por este valor.
SOURCE_MAX_CONCURRENCY=5
# Protecao central para envios concorrentes ao Telegram.
TELEGRAM_CHAT_INTERVAL_SECONDS=1.0
TELEGRAM_GLOBAL_MESSAGES_PER_SECOND=30

# Promotion Engine V1
# Copie promotions.example.json para promotions.json e ative apenas cupons/campanhas confirmados.
PROMOTIONS_FILE=promotions.json
# ML: abre uma amostra de anúncios no Chrome logado para detectar cupons visíveis.
ML_COUPON_DISCOVERY_ENABLED=true
ML_COUPON_SCAN_ITEMS=16
ML_COUPON_CACHE_HOURS=6
ML_COUPON_POSITIVE_CACHE_HOURS=2
ML_PROMO_REVIVAL_COOLDOWN_HOURS=6
ML_PROMO_REVIVAL_MIN_DROP_PERCENT=5
ML_PROMO_REVIVAL_MIN_DROP_AMOUNT=20
# Avisos únicos de campanhas futuras descritas em promotions.json.
PROMOTION_CAMPAIGN_NOTICES_ENABLED=true

# Steam / ITAD
ITAD_API_KEY=
STEAM_MIN_DISCOUNT_PERCENT=40
STEAM_MAX_POSTS_PER_CYCLE=5
STEAM_BUNDLE_SCAN_APPS=24
STEAM_MIN_REVIEW_SCORE=80
STEAM_MIN_REVIEW_COUNT=500
STEAM_MIN_WAITLISTED=1000
PLUS_EDITORIAL_MIN_SCORE=25
PLUS_EDITORIAL_HOURS_WITHOUT=24

# AliExpress - Open Platform / Portals
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=default
# Formato: palavra:category_id,palavra:category_id. Categoria pode ficar vazia.
ALIEXPRESS_SEARCHES=SSD:7,placa de video:7,teclado:7,mouse:7
ALIEXPRESS_MIN_DISCOUNT_PERCENT=30
ALIEXPRESS_MAX_POSTS_PER_CYCLE=3

# Green Man Gaming / impact.com
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
# O bot descobre programa/catalogo automaticamente; IDs manuais sao opcionais.
# Shopee Afiliados (Open API GraphQL) — NUNCA commitar o valor real de SHOPEE_APP_SECRET.
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_KEYWORDS=
TELEGRAM_SHOPEE_THREAD_ID=
SHOPEE_MIN_DISCOUNT_PERCENT=30
SHOPEE_MAX_POSTS_PER_CYCLE=3

# Kabum Afiliados (via rede Awin) — NUNCA commitar o valor real de KABUM_AWIN_TOKEN.
# Token OAuth2 obtido no painel da Awin apos aprovacao no programa da Kabum BR.
KABUM_AWIN_TOKEN=
KABUM_PUBLISHER_ID=
TELEGRAM_KABUM_THREAD_ID=
KABUM_MIN_DISCOUNT_PERCENT=15
KABUM_MAX_POSTS_PER_CYCLE=3

GMG_PROGRAM_ID=
GMG_CATALOG_ID=
GMG_CATALOG_CURRENCY=BRL
GMG_CATALOG_PAGE_SIZE=1000
GMG_CATALOG_MAX_PAGES=10
GMG_MIN_DISCOUNT_PERCENT=30
GMG_MAX_POSTS_PER_CYCLE=3

# Digest
DIGEST_ENABLED=true
DIGEST_HOUR=21
DIGEST_MAX_ITEMS=5

# Click Tracking
CLICK_TRACKING_ENABLED=false
CLICK_SERVER_PORT=8321
CLICK_BASE_URL=http://localhost:8321
